# CoinAnk 自动抓取脚本环境变量示例
# 复制此文件为 .env 并填写实际值

# GitHub 个人访问令牌（需要 repo 权限）
GITHUB_TOKEN=your_github_token_here

# GitHub 仓库（格式：username/repo）
GITHUB_REPO=Bachopin/coinank

# Notion 集成令牌（从 https://www.notion.so/my-integrations 获取）
NOTION_TOKEN=your_notion_integration_token_here

# Notion 数据库 ID（从数据库 URL 中提取）
NOTION_DB_ID=your_notion_database_id_here

# 可选：设置时区（默认 Asia/Shanghai）
# TZ=Asia/Shanghai